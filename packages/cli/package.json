{
  "name": "insy",
  "version": "0.0.2",
  "description": "AI-powered visual code editing for any frontend framework",
  "type": "module",
  "bin": {
    "insy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "code-editing",
    "react",
    "vue",
    "html",
    "developer-tools",
    "opencode"
  ],
  "author": "Irasubiza Divin Prince",
  "license": "MIT",
  "dependencies": {
    "@insy/server": "workspace:*",
    "commander": "^11.1.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DivinPrince/insy.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/DivinPrince/insy#readme",
  "bugs": {
    "url": "https://github.com/DivinPrince/insy/issues"
  }
}