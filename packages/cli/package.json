{
  "name": "insy",
  "version": "0.4.1",
  "description": "AI-powered visual code editing for any frontend framework",
  "type": "module",
  "bin": {
    "insy": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun tsc",
    "dev": "bun tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "bun tsc --noEmit"
  },
  "keywords": [
    "ai",
    "code-editing",
    "react",
    "vue",
    "html",
    "developer-tools",
    "opencode"
  ],
  "author": "Insy Team",
  "license": "MIT",
  "dependencies": {
    "@insy/server": "workspace:*",
    "commander": "^11.1.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  }
}
