{
  "name": "@insy/next",
  "version": "0.0.3",
  "description": "Next.js plugin for Insy - AI-powered visual editing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@insy/server": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "next": ">=13.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "next",
    "nextjs",
    "insy",
    "ai",
    "visual-editing",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DivinPrince/insy.git",
    "directory": "packages/next-plugin"
  },
  "homepage": "https://github.com/DivinPrince/insy#readme",
  "bugs": {
    "url": "https://github.com/DivinPrince/insy/issues"
  }
}