{
  "name": "@insy/shared",
  "version": "0.1.0",
  "description": "Shared types and utilities for Insy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun tsc",
    "dev": "bun tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "bun tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
