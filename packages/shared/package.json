{
  "name": "@pixelcode/shared",
  "version": "0.1.0",
  "description": "Shared types and utilities for PixelCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
