{
  "name": "@insy/server",
  "version": "0.0.5",
  "description": "Insy local server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "insy-server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^7.23.6",
    "@hono/node-server": "^1.19.6",
    "@insy/client": "workspace:*",
    "@opencode-ai/sdk": "^1.0.134",
    "diff": "^5.1.0",
    "fast-glob": "^3.3.2",
    "hono": "^4.10.7",
    "picocolors": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@insy/shared": "workspace:*",
    "@types/babel__traverse": "^7.20.5",
    "@types/diff": "^5.0.9",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "insy",
    "ai",
    "visual-editing",
    "code-editing",
    "developer-tools",
    "opencode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DivinPrince/insy.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/DivinPrince/insy#readme",
  "bugs": {
    "url": "https://github.com/DivinPrince/insy/issues"
  }
}