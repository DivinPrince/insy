{
  "name": "@insy/vite",
  "version": "0.0.8",
  "description": "Vite plugin for Insy - AI-powered visual editing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@insy/client": "workspace:*",
    "@insy/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "insy",
    "ai",
    "visual-editing",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DivinPrince/insy.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/DivinPrince/insy#readme",
  "bugs": {
    "url": "https://github.com/DivinPrince/insy/issues"
  }
}