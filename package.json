{
  "name": "pixelcode",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered visual code editing for any frontend framework",
  "keywords": ["ai", "code-editing", "react", "vue", "html", "developer-tools"],
  "author": "PixelCode Team",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "dev": "bun run --filter './packages/*' dev",
    "clean": "bun run --filter './packages/*' clean",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "bun run --filter './packages/*' lint"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "prettier": "^3.1.1",
    "eslint": "^8.56.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
