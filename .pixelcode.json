{
  "version": "1.0",
  "tool": "opencode",
  "project": {
    "path": "D:\\insy",
    "name": "Insy"
  },
  "server": {
    "port": 7777,
    "host": "localhost"
  },
  "opencode": {
    "session": "Insy",
    "continueSession": true
  },
  "ui": {
    "keybind": "cmd+shift+p",
    "theme": "dark"
  },
  "search": {
    "include": [
      "src/**/*",
      "app/**/*",
      "pages/**/*",
      "components/**/*"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**"
    ]
  }
}